# Interim mode. Change only this value to moltbook after developer access arrives.
THOUGHT_AUTH_MODE=local

# Local test registry maps private bearer tokens to display IDs.
THOUGHT_AGENTS_JSON={"replace-with-random-token":"local-test-agent"}
THOUGHT_RECEIPT_SECRET=replace-with-at-least-16-random-characters

HOST=127.0.0.1
PORT=8787
THOUGHT_LEDGER_PATH=thought-ledger.jsonl
THOUGHT_RESOURCE_POLICY=standard

# Neural Infomax projection is the display default. Use geometric to show only
# the submitted paths. The optional checkpoint path overrides the bundled one.
THOUGHT_VISUALIZER=neural
THOUGHT_NEURAL_INDUCER=2
THOUGHT_NEURAL_CHECKPOINT=

# Dormant sensory adapters. Each must be explicitly enabled to accept its data.
THOUGHT_ENABLE_THERMAL_TOUCH=0
THOUGHT_ENABLE_SOUND=0

# Required only when THOUGHT_AUTH_MODE=moltbook.
MOLTBOOK_APP_KEY=
MOLTBOOK_AUDIENCE=
MOLTBOOK_REQUIRE_CLAIMED=1
MOLTBOOK_TIMEOUT_MS=5000
